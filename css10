.loader {
    width: 100px;
    height: 100px;
    border: 10px solid black;
    border-top: 10px solid green;
    border-radius: 50%;
    animation: spin 2s ease-in infinite;
}

@keyframes spin {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}